# Without a key the app runs in mock mode (same API-shaped responses, no cost).
ANTHROPIC_API_KEY=
# Optional: require a code in the UI (recommended for a public demo)
ACCESS_CODE=
RUNS_PER_HOUR=20
MAX_RETURNS=1
# Model tiers used by the router's plan
MODEL_FAST=claude-haiku-5-5
MODEL_BALANCED=claude-sonnet-5-5
MODEL_STRONG=claude-opus-5-5
# Behind Caddy/nginx: trust the last X-Forwarded-For hop for the rate limit
TRUST_PROXY=0
MAX_CONCURRENT_RUNS=3
# Cost estimate in the UI, USD per 1M tokens "input,output" (check your pricing)
PRICE_FAST=1,5
PRICE_BALANCED=2,10
PRICE_STRONG=4,20
PRICE_WEB_SEARCH=0.01
