[Unit]
Description=Research Agents (multi-agent research assistant)
After=network.target

[Service]
WorkingDirectory=/opt/research-agents
EnvironmentFile=/etc/research-agents.env
Environment=LOG_DIR=/var/lib/research-agents/logs
ExecStart=/opt/research-agents-venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --proxy-headers
Restart=on-failure
User=research
StateDirectory=research-agents
MemoryMax=450M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
